{
  "name": "@adaptive/ui",
  "version": "0.1.37",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:embedded": "tsc --noEmit && VITE_EMBEDDED=true vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx && tsc --noEmit",
    "test": "vitest",
    "test:e2e": "playwright test -c playwright.config.ts"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.68.0",
    "@fluentui/react-icons": "^2.0.300",
    "@tanstack/react-query": "^5.62.7",
    "oidc-client-ts": "3.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.28.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.1",
    "jsdom": "^25.0.1",
    "msw": "^2.7.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
